# ─────────────────────────────────────────────────────────────────────────────
# Orbiqon GEO Suite — environment
# Copy to `.env` (repo root) and fill in. Everything is optional: with NO keys the
# app runs in MOCK mode (deterministic fake answers) so the vertical slice works
# offline with zero external dependencies.
# ─────────────────────────────────────────────────────────────────────────────

# Force the mock provider even if real keys are present. "true" | "false".
# When unset: mock is used automatically for any engine whose API key is missing.
# To run LIVE, set this to false (or leave unset) and provide a key below.
MOCK_LLM=true

# ── OpenRouter (recommended): one gateway, one balance, all four engines ───────
# If OPENROUTER_API_KEY is set, every live engine routes through OpenRouter using
# your credits. This takes precedence over the individual provider keys below.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional per-engine model slug overrides (defaults shown):
OPENROUTER_CHATGPT_MODEL=openai/gpt-4o
OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash
OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar
OPENROUTER_SITE_URL=https://geostudio.ai
# Enable OpenRouter web search (":online") so answers reflect the current web.
# "false" to query base models only (cheaper). Default: on.
OPENROUTER_WEB_SEARCH=true
# Cheap model that writes the buyer-prompt grid when a scan has no prompts.
OPENROUTER_PROMPTGEN_MODEL=openai/gpt-4o-mini

# ── Or individual provider SDKs (used only if OPENROUTER_API_KEY is empty).
#    Model IDs are configurable; defaults live in packages/query-engine/src/providers/*.ts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
# Default is Opus 4.8 (most capable). It's the priciest tier — for a high-volume
# sampling tool you may want a cheaper model, e.g. claude-haiku-4-5. Your call.
ANTHROPIC_MODEL=claude-opus-4-8

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ── Sampling & cost controls (see packages/query-engine/src/cost-guard.ts)
# How many times each (prompt × engine) is sampled. Honest sampling → a RATE.
QUERY_ENGINE_SAMPLES=3
# Hard caps enforced per scan. Total live calls per scan <= MAX_PROMPTS * MAX_SAMPLES.
MAX_PROMPTS=5
MAX_SAMPLES=5
# IP rate limit on /api/scan: max scans per IP per hour (unauthenticated free tool).
SCAN_RATE_LIMIT=10

# ── Supabase Postgres (via Prisma). Leave blank to run without persistence.
# DATABASE_URL uses the pooled (pgbouncer) connection; DIRECT_URL the direct one
# for migrations. Get both from Supabase → Project Settings → Database.
DATABASE_URL=
DIRECT_URL=
