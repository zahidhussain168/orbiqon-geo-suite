{
  "name": "@orbiqon/query-engine",
  "version": "0.0.0",
  "description": "Ask the AI engines and read the answer. Framework-agnostic core of the Orbiqon GEO Suite.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "signal-check": "tsx scripts/signal-check.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/generative-ai": "^0.24.1",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@orbiqon/entity-resolver": "workspace:*",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
